--- /dev/null
+++ b/src/app/lib/machine-policy.js
@@ -0,0 +1,164 @@
+/**
+ * Права сотрудников на машины.
+ *
+ * Адрес цели приходит от клиента вместе с закладкой. В однопользовательском
+ * режиме это нормально: пользователь и так хозяин сервера. В командном -- нет:
+ * без серверной проверки любой сотрудник, введя другой адрес, подключается к
+ * машине, доступа к которой ему не давали, и заодно превращает наш узел в
+ * универсальный прокси внутрь сети.
+ *
+ * Политика описывается файлом, потому что так её можно держать в системе
+ * контроля версий и раздавать вместе с инфраструктурой. Когда появится
+ * PostgreSQL, файл станет одним из источников, а интерфейс проверки не
+ * изменится.
+ *
+ * Формат:
+ * {
+ *   "admins": ["boss@example.com"],
+ *   "users": {
+ *     "ivanov@example.com": ["10.99.0.11", "10.99.0.12:3389", "*.corp.example.com"],
+ *     "petrov@example.com": ["10.99.0.0/24"]
+ *   }
+ * }
+ */
+
+import { readFileSync, statSync } from 'fs'
+import { resolve } from 'path'
+import { cwd } from '../common/runtime-constants.js'
+import { cfAccessEnabled } from './cf-access.js'
+import log from '../common/log.js'
+
+// В командном режиме проверка включена всегда. Отдельная переменная нужна для
+// стендов без Cloudflare Access.
+export const policyEnforced = cfAccessEnabled ||
+  process.env.ENFORCE_MACHINE_POLICY === '1'
+
+const policyPath = process.env.MACHINE_POLICY_PATH ||
+  resolve(process.env.DB_PATH || resolve(cwd, 'data'), 'machine-policy.json')
+
+let cache = { mtimeMs: 0, policy: null }
+
+/**
+ * Файл перечитывается при изменении: выдача доступа новому сотруднику не должна
+ * требовать перезапуска, иначе она рвёт чужие сессии.
+ */
+function loadPolicy () {
+  const stat = statSync(policyPath)
+  if (cache.policy && cache.mtimeMs === stat.mtimeMs) {
+    return cache.policy
+  }
+  const parsed = JSON.parse(readFileSync(policyPath, 'utf8'))
+  const policy = {
+    admins: (parsed.admins || []).map(s => String(s).toLowerCase()),
+    users: Object.fromEntries(
+      Object.entries(parsed.users || {}).map(([k, v]) => [String(k).toLowerCase(), v])
+    )
+  }
+  cache = { mtimeMs: stat.mtimeMs, policy }
+  return policy
+}
+
+function ipToInt (ip) {
+  const parts = ip.split('.')
+  if (parts.length !== 4) {
+    return null
+  }
+  let n = 0
+  for (const p of parts) {
+    const v = Number(p)
+    if (!Number.isInteger(v) || v < 0 || v > 255) {
+      return null
+    }
+    n = (n * 256) + v
+  }
+  return n
+}
+
+function matchesCidr (host, rule) {
+  const [net, bitsRaw] = rule.split('/')
+  const bits = Number(bitsRaw)
+  if (!Number.isInteger(bits) || bits < 0 || bits > 32) {
+    return false
+  }
+  const a = ipToInt(host)
+  const b = ipToInt(net)
+  if (a === null || b === null) {
+    return false
+  }
+  // Сдвиг на 32 в JavaScript не даёт нуля, поэтому маска считается делением.
+  const mask = bits === 0 ? 0 : ~((2 ** (32 - bits)) - 1) >>> 0
+  return (a & mask) === (b & mask)
+}
+
+function matchesRule (host, port, rule) {
+  const r = String(rule).trim().toLowerCase()
+  const h = String(host).trim().toLowerCase()
+  if (!r) {
+    return false
+  }
+  if (r === '*') {
+    return true
+  }
+  if (r.includes('/')) {
+    return matchesCidr(h, r)
+  }
+  // Правило с портом ограничивает и протокол: 10.0.0.5:3389 разрешает RDP, но
+  // не SSH на ту же машину.
+  const [rHost, rPort] = r.split(':')
+  if (rPort && String(port) !== rPort) {
+    return false
+  }
+  if (rHost.startsWith('*.')) {
+    return h.endsWith(rHost.slice(1))
+  }
+  return h === rHost
+}
+
+/**
+ * Бросает исключение, если сотруднику нельзя подключаться к этой машине.
+ * Отсутствие политики в командном режиме -- отказ, а не разрешение: иначе
+ * забытый файл тихо открывает всё всем.
+ */
+export function assertMachineAllowed (user, initOptions = {}) {
+  if (!policyEnforced) {
+    return
+  }
+  const type = String(initOptions.termType || initOptions.type || '').toLowerCase()
+  const host = initOptions.host
+  const port = initOptions.port
+
+  if (!user) {
+    throw new Error('machine access denied: no identity')
+  }
+
+  let policy
+  try {
+    policy = loadPolicy()
+  } catch (err) {
+    log.error(`machine policy unavailable (${policyPath}): ${err.message}`)
+    throw new Error('machine access denied: policy is not configured')
+  }
+
+  const email = String(user).toLowerCase()
+  if (policy.admins.includes(email)) {
+    return
+  }
+
+  // Локальная оболочка -- это доступ к самому web-узлу, а не к целевой машине.
+  // Её получают только администраторы.
+  if (type === 'local') {
+    log.error(`user ${email} tried to open local shell`)
+    throw new Error('machine access denied: local terminal is for admins only')
+  }
+
+  if (!host) {
+    throw new Error('machine access denied: no host in request')
+  }
+
+  const rules = policy.users[email] || []
+  if (rules.some(rule => matchesRule(host, port, rule))) {
+    return
+  }
+  log.error(`user ${email} tried to connect to ${host}:${port ?? ''} (${type})`)
+  throw new Error(`machine access denied: ${host}`)
+}
