# Скопировать в /opt/electerm-platform/.env на узле и заполнить.
# Файл с реальными значениями в репозиторий не попадает (см. .gitignore).

# Образы только с digest. Получить digest:
#   docker buildx imagetools inspect <image>:<tag> | grep Digest
APP_IMAGE=ghcr.io/ORG/electerm-platform@sha256:REPLACE_ME
POSTGRES_IMAGE=postgres@sha256:REPLACE_ME

# Аутентификация приложения.
# SERVER_PASS -- общий пароль стокового electerm-web. После перехода на
# многопользовательский режим личности приходят из Cloudflare Access, и этот
# пароль остаётся только страховкой на случай обхода туннеля.
SERVER_PASS=
SERVER_SECRET=

# База данных
POSTGRES_DB=electerm
POSTGRES_USER=electerm
POSTGRES_PASSWORD=

# Идентификация через Cloudflare Access.
# AUD берётся из настроек приложения в Zero Trust, TEAM_DOMAIN вида
# your-team.cloudflareaccess.com. Приложение проверяет JWT из заголовка
# Cf-Access-Jwt-Assertion по публичным ключам этого домена.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Отключение внешних вызовов стокового кода.
DISABLE_AI_DEFAULT=1
DISABLE_SYNC_GIST=1
DISABLE_UPDATE_CHECK=1
