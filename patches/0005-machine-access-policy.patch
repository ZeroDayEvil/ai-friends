diff --git a/test/machine-policy.test.mjs b/test/machine-policy.test.mjs
new file mode 100644
index 0000000..6457638
--- /dev/null
+++ b/test/machine-policy.test.mjs
@@ -0,0 +1,122 @@
+/**
+ * Проверка прав на машины.
+ *
+ * Запуск: node test/machine-policy.test.mjs
+ */
+
+import assert from 'assert'
+import { mkdtempSync, writeFileSync, rmSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+
+const dir = mkdtempSync(join(tmpdir(), 'policy-'))
+const policyPath = join(dir, 'machine-policy.json')
+
+writeFileSync(policyPath, JSON.stringify({
+  admins: ['Boss@example.com'],
+  users: {
+    'ivanov@example.com': ['10.99.0.11', '10.99.0.12:3389', '*.corp.example.com'],
+    'petrov@example.com': ['10.99.0.0/24']
+  }
+}))
+
+process.env.ENFORCE_MACHINE_POLICY = '1'
+process.env.MACHINE_POLICY_PATH = policyPath
+
+const { assertMachineAllowed, policyEnforced } =
+  await import('../src/app/lib/machine-policy.js')
+
+const results = []
+function check (name, fn) {
+  try {
+    fn()
+    results.push(['PASS', name])
+  } catch (err) {
+    results.push(['FAIL', name, err.message])
+  }
+}
+
+const ssh = (host, port = 22) => ({ termType: 'ssh', host, port })
+
+check('проверка включена переменной окружения', () => {
+  assert.strictEqual(policyEnforced, true)
+})
+
+check('разрешённая машина доступна', () => {
+  assertMachineAllowed('ivanov@example.com', ssh('10.99.0.11'))
+})
+
+check('регистр адреса почты не важен', () => {
+  assertMachineAllowed('IVANOV@example.com', ssh('10.99.0.11'))
+})
+
+check('чужая машина недоступна', () => {
+  assert.throws(() => assertMachineAllowed('ivanov@example.com', ssh('10.99.0.99')),
+    /machine access denied/)
+})
+
+check('правило с портом ограничивает и протокол', () => {
+  assertMachineAllowed('ivanov@example.com', { termType: 'rdp', host: '10.99.0.12', port: 3389 })
+  assert.throws(() => assertMachineAllowed('ivanov@example.com', ssh('10.99.0.12')),
+    /machine access denied/)
+})
+
+check('подстановка в имени домена работает', () => {
+  assertMachineAllowed('ivanov@example.com', ssh('srv1.corp.example.com'))
+  assert.throws(() => assertMachineAllowed('ivanov@example.com', ssh('srv1.evil.com')),
+    /machine access denied/)
+})
+
+check('подстановка не пропускает похожий домен', () => {
+  assert.throws(
+    () => assertMachineAllowed('ivanov@example.com', ssh('corp.example.com.evil.net')),
+    /machine access denied/
+  )
+})
+
+check('подсеть разрешает адреса внутри и запрещает снаружи', () => {
+  assertMachineAllowed('petrov@example.com', ssh('10.99.0.200'))
+  assert.throws(() => assertMachineAllowed('petrov@example.com', ssh('10.99.1.5')),
+    /machine access denied/)
+})
+
+check('администратору доступно всё', () => {
+  assertMachineAllowed('boss@example.com', ssh('1.2.3.4'))
+  assertMachineAllowed('boss@example.com', { termType: 'local' })
+})
+
+check('локальная оболочка недоступна обычному сотруднику', () => {
+  assert.throws(() => assertMachineAllowed('ivanov@example.com', { termType: 'local' }),
+    /local terminal is for admins/)
+})
+
+check('неизвестный сотрудник не имеет доступа', () => {
+  assert.throws(() => assertMachineAllowed('nobody@example.com', ssh('10.99.0.11')),
+    /machine access denied/)
+})
+
+check('запрос без личности отвергается', () => {
+  assert.throws(() => assertMachineAllowed(undefined, ssh('10.99.0.11')),
+    /no identity/)
+})
+
+check('запрос без адреса отвергается', () => {
+  assert.throws(() => assertMachineAllowed('ivanov@example.com', { termType: 'ssh' }),
+    /no host/)
+})
+
+// Главная проверка: отсутствие политики должно закрывать доступ, а не открывать.
+check('без файла политики доступ закрыт', () => {
+  rmSync(policyPath)
+  assert.throws(() => assertMachineAllowed('ivanov@example.com', ssh('10.99.0.11')),
+    /policy is not configured/)
+})
+
+rmSync(dir, { recursive: true, force: true })
+
+const failed = results.filter(r => r[0] === 'FAIL')
+for (const r of results) {
+  console.log(`${r[0]}  ${r[1]}${r[2] ? '  -- ' + r[2] : ''}`)
+}
+console.log(`\nвсего ${results.length}, провалено ${failed.length}`)
+process.exit(failed.length ? 1 : 0)
