{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-friends:schema:agent:v1:tool-descriptor",
  "title": "Описание инструмента",
  "type": "object",
  "description": "Реестровая запись об инструменте. Модель никогда не видит инструмент, которого нет в этом реестре, и никогда не видит описание, отличное от закреплённого: описание инструмента — это вход в модель, то есть такой же канал влияния, как и содержимое веб-страницы. Смена descriptor_hash аннулирует все выданные ранее одобрения по этому инструменту.",
  "properties": {
    "schema": { "const": "urn:ai-friends:schema:agent:v1:tool-descriptor" },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$", "maxLength": 64 },
    "tool_version": { "type": "integer", "minimum": 1 },
    "descriptor_hash": {
      "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/sha256",
      "description": "Хеш канонизированного описания без самого этого поля. Закрепляет текст, который увидит модель, и набор аргументов."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 96 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "semantics": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/semantics" },
    "effect_class": {
      "enum": ["read", "mutate_local", "mutate_remote", "exec", "network", "publish", "credential"]
    },
    "risk": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/risk" },
    "release": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/release" },
    "supervision": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/supervision" },
    "requires_capabilities": {
      "type": "array",
      "items": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/action" },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "approval_policy": { "enum": ["never", "first_use", "always"] },
    "cancellable": {
      "enum": ["none", "cooperative", "hard"],
      "description": "cooperative — исполнителю посылается сигнал, но действие может уже быть применено. hard — исполнение прерывается с гарантией, что побочный эффект не начался. none — отменить нельзя."
    },
    "retry": {
      "type": "object",
      "properties": {
        "safe": { "type": "boolean" },
        "dedup_window_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
      },
      "required": ["safe"],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": ["fields"],
      "additionalProperties": false,
      "description": "Типизированное описание аргументов. Оно же управляет канонизацией: поля типа path сводятся к паре «корень + относительный путь», поля с secret=true заменяются ссылкой на профиль. Без такого описания хеш аргументов зависел бы от написания пути, и одобрение обходилось бы переписыванием того же пути иначе."
    },
    "output": {
      "type": "object",
      "properties": {
        "provenance": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/provenance" },
        "max_bytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "streamed": { "type": "boolean" }
      },
      "required": ["provenance", "max_bytes"],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "record_args": {
          "type": "array",
          "items": { "type": "string", "maxLength": 64 },
          "uniqueItems": true,
          "maxItems": 32,
          "description": "Белый список аргументов, которые попадают в журнал. Всё, чего нет в списке, не записывается. Обратный порядок — «записываем всё, кроме перечисленного» — оставляет утечку при добавлении нового аргумента."
        },
        "record_output": { "enum": ["none", "hash", "truncated", "full"] }
      },
      "required": ["record_args", "record_output"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "tool",
    "tool_version",
    "descriptor_hash",
    "title",
    "summary",
    "semantics",
    "effect_class",
    "risk",
    "release",
    "supervision",
    "requires_capabilities",
    "approval_policy",
    "cancellable",
    "retry",
    "args",
    "output",
    "audit"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "semantics": { "const": "at_most_once" } }, "required": ["semantics"] },
      "then": {
        "properties": { "retry": { "properties": { "safe": { "const": false } } } },
        "description": "Повтор небезопасен по определению. Автоповтор на любом уровне — в агенте, в оркестраторе, в транспорте — для таких инструментов запрещён; потерянный ответ даёт effect=unknown и разбирается человеком."
      }
    },
    {
      "if": { "properties": { "semantics": { "const": "read_only" } }, "required": ["semantics"] },
      "then": { "properties": { "effect_class": { "const": "read" } } }
    },
    {
      "if": { "properties": { "effect_class": { "enum": ["exec", "mutate_remote", "publish", "credential"] } }, "required": ["effect_class"] },
      "then": {
        "properties": { "approval_policy": { "enum": ["first_use", "always"] } },
        "description": "Выполнение команды, изменение цели, публикация ресурса и работа с учётными данными без одобрения не выполняются никогда."
      }
    },
    {
      "if": { "properties": { "release": { "const": "A" } }, "required": ["release"] },
      "then": { "properties": { "supervision": { "const": "supervised" } } }
    },
    {
      "if": { "properties": { "risk": { "const": "critical" } }, "required": ["risk"] },
      "then": {
        "properties": {
          "approval_policy": { "const": "always" },
          "audit": { "properties": { "record_output": { "enum": ["hash", "truncated", "full"] } } }
        }
      }
    }
  ],
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "enum",
            "bytes",
            "duration_seconds",
            "path",
            "root_ref",
            "machine_ref",
            "machine_endpoint_ref",
            "session_ref",
            "bookmark_ref",
            "share_ref",
            "task_ref",
            "credential_profile_ref",
            "destination_group_ref",
            "command_template_ref",
            "argv"
          ]
        },
        "required": { "type": "boolean" },
        "secret": {
          "type": "boolean",
          "description": "Значение является учётными данными. Такое поле не попадает ни в хеш аргументов, ни в журнал, ни в контекст модели; на его месте всегда стоит ссылка на профиль."
        },
        "max_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "enum_values": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "minItems": 1, "maxItems": 64, "uniqueItems": true },
        "description": { "type": "string", "maxLength": 256 }
      },
      "required": ["name", "type", "required"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["enum_values"] }
        },
        {
          "if": { "properties": { "secret": { "const": true } }, "required": ["secret"] },
          "then": {
            "properties": { "type": { "const": "credential_profile_ref" } },
            "description": "Секрет нельзя передать значением. Единственный допустимый способ — ссылка на профиль, которую разрешает брокер."
          }
        },
        {
          "if": { "properties": { "type": { "const": "argv" } }, "required": ["type"] },
          "then": {
            "properties": { "max_bytes": { "maximum": 65536 } },
            "description": "argv — массив аргументов, передаваемый процессу напрямую. Строки командной оболочки в контракте нет: как только появляется оболочка, разбор аргументов уходит на её сторону, и никакая проверка на нашей стороне не описывает того, что выполнится."
          }
        }
      ]
    }
  }
}
