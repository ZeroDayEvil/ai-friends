diff --git a/test/cf-access.test.mjs b/test/cf-access.test.mjs
new file mode 100644
index 0000000..699ffcd
--- /dev/null
+++ b/test/cf-access.test.mjs
@@ -0,0 +1,128 @@
+/**
+ * Проверка модуля личности Cloudflare Access.
+ *
+ * Тест не обращается к Cloudflare: поднимается локальный сервер набора ключей,
+ * и токены подписываются настоящей парой RSA. Это позволяет проверить именно
+ * то, что важно -- что подделанный, чужой или просроченный токен отвергается.
+ *
+ * Запуск: node test/cf-access.test.mjs
+ */
+
+import { createServer } from 'http'
+import { generateKeyPairSync } from 'crypto'
+import jwt from 'jsonwebtoken'
+import assert from 'assert'
+
+const TEAM = 'test-team.cloudflareaccess.com'
+const AUD = 'a'.repeat(64)
+const KID = 'test-kid-1'
+
+const { publicKey, privateKey } = generateKeyPairSync('rsa', { modulusLength: 2048 })
+const jwk = { ...publicKey.export({ format: 'jwk' }), kid: KID, alg: 'RS256', use: 'sig' }
+
+// Второй ключ: им подписываем токен, чтобы проверить отказ при неверной подписи.
+const other = generateKeyPairSync('rsa', { modulusLength: 2048 })
+
+let certsRequests = 0
+const server = createServer((req, res) => {
+  certsRequests++
+  res.writeHead(200, { 'content-type': 'application/json' })
+  res.end(JSON.stringify({ keys: [jwk] }))
+})
+
+await new Promise(resolve => server.listen(0, '127.0.0.1', resolve))
+const { port } = server.address()
+
+process.env.CF_ACCESS_TEAM_DOMAIN = TEAM
+process.env.CF_ACCESS_AUD = AUD
+process.env.CF_ACCESS_CERTS_URL = `http://127.0.0.1:${port}/cdn-cgi/access/certs`
+
+const { verifyAccessToken, extractAccessToken, cfAccessEnabled } =
+  await import('../src/app/lib/cf-access.js')
+
+function sign (payload, key = privateKey, opts = {}) {
+  return jwt.sign(payload, key, { algorithm: 'RS256', keyid: KID, ...opts })
+}
+
+const base = {
+  email: 'Ivanov@example.com',
+  sub: 'user-1',
+  aud: AUD,
+  iss: `https://${TEAM}`
+}
+
+const results = []
+async function check (name, fn) {
+  try {
+    await fn()
+    results.push(['PASS', name])
+  } catch (err) {
+    results.push(['FAIL', name, err.message])
+  }
+}
+
+async function mustReject (name, token) {
+  await check(name, async () => {
+    await assert.rejects(() => verifyAccessToken(token))
+  })
+}
+
+await check('режим включается при заданных настройках', () => {
+  assert.strictEqual(cfAccessEnabled, true)
+})
+
+await check('действительный токен принимается, почта в нижнем регистре', async () => {
+  const identity = await verifyAccessToken(sign(base, privateKey, { expiresIn: '1h' }))
+  assert.strictEqual(identity.email, 'ivanov@example.com')
+  assert.strictEqual(identity.sub, 'user-1')
+})
+
+await mustReject('подпись чужим ключом отвергается',
+  sign(base, other.privateKey, { expiresIn: '1h' }))
+
+await mustReject('токен для другого приложения отвергается',
+  sign({ ...base, aud: 'b'.repeat(64) }, privateKey, { expiresIn: '1h' }))
+
+await mustReject('чужой издатель отвергается',
+  sign({ ...base, iss: 'https://evil.example.com' }, privateKey, { expiresIn: '1h' }))
+
+await mustReject('просроченный токен отвергается',
+  sign(base, privateKey, { expiresIn: '-1h' }))
+
+await mustReject('токен без личности отвергается',
+  sign({ sub: 'x', aud: AUD, iss: `https://${TEAM}` }, privateKey, { expiresIn: '1h' }))
+
+// Подмена алгоритма: токен, подписанный HMAC-ом с публичным ключом в качестве
+// секрета. Классический обход, если сервер не фиксирует список алгоритмов.
+await mustReject('подмена алгоритма на HS256 отвергается',
+  jwt.sign(base, publicKey.export({ type: 'spki', format: 'pem' }),
+    { algorithm: 'HS256', keyid: KID, expiresIn: '1h' }))
+
+await mustReject('пустой токен отвергается', '')
+await mustReject('мусор вместо токена отвергается', 'not-a-jwt')
+
+await check('токен берётся из заголовка', () => {
+  const req = { headers: { 'cf-access-jwt-assertion': 'from-header', cookie: 'CF_Authorization=from-cookie' } }
+  assert.strictEqual(extractAccessToken(req), 'from-header')
+})
+
+await check('токен берётся из куки, если заголовка нет', () => {
+  const req = { headers: { cookie: 'other=1; CF_Authorization=from-cookie; x=2' } }
+  assert.strictEqual(extractAccessToken(req), 'from-cookie')
+})
+
+await check('ключи кешируются, а не запрашиваются на каждый токен', async () => {
+  const before = certsRequests
+  await verifyAccessToken(sign(base, privateKey, { expiresIn: '1h' }))
+  await verifyAccessToken(sign(base, privateKey, { expiresIn: '1h' }))
+  assert.strictEqual(certsRequests, before)
+})
+
+server.close()
+
+const failed = results.filter(r => r[0] === 'FAIL')
+for (const r of results) {
+  console.log(`${r[0]}  ${r[1]}${r[2] ? '  -- ' + r[2] : ''}`)
+}
+console.log(`\nвсего ${results.length}, провалено ${failed.length}`)
+process.exit(failed.length ? 1 : 0)
