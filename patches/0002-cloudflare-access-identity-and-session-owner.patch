@@ -0,0 +1,51 @@
+/**
+ * Владельцы сессий.
+ *
+ * В стоковой версии все сессии живут в одном общем реестре, а проверка при
+ * подключении к WebSocket сводится к «токен подписан нашим секретом». Для
+ * одного пользователя этого достаточно, для команды -- нет: зная идентификатор
+ * сессии, любой обладатель действительного токена подключился бы к чужому
+ * терминалу.
+ *
+ * Здесь фиксируется, кто создал сессию, и подключение к ней разрешается только
+ * ему. Это не полная изоляция: сессии по-прежнему живут в одном процессе Node,
+ * и ошибка в самом приложении по-прежнему даёт доступ к памяти со всеми
+ * учётными данными. Настоящая изоляция требует отдельного процесса на
+ * пользователя, см. docs/design/multiuser.md.
+ */
+
+import log from '../common/log.js'
+
+const owners = new Map()
+
+export function claimSession (sessionId, user) {
+  if (!sessionId || !user) {
+    return
+  }
+  owners.set(sessionId, user)
+}
+
+export function releaseSession (sessionId) {
+  owners.delete(sessionId)
+}
+
+/**
+ * Сессия без известного владельца считается недоступной, а не общей: тихо
+ * разрешить доступ к ней означало бы оставить обход проверки в любом сценарии,
+ * который забыли пометить владельцем.
+ */
+export function assertSessionOwner (sessionId, user) {
+  const owner = owners.get(sessionId)
+  if (owner === undefined) {
+    log.error(`session ${sessionId} has no owner, access denied`)
+    throw new Error('unknown session')
+  }
+  if (owner !== user) {
+    log.error(`user ${user} tried to attach to session of ${owner}`)
+    throw new Error('session belongs to another user')
+  }
+}
+
+export function ownerOf (sessionId) {
+  return owners.get(sessionId)
+}
