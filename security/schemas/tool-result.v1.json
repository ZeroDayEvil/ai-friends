{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-friends:schema:agent:v1:tool-result",
  "title": "Успешный или частичный результат инструмента",
  "type": "object",
  "description": "Результат всегда сообщает, что стало с состоянием цели. Поле effect существует именно ради случая, когда мы не знаем: молчание об этом приводит к повторному выполнению уже применённого действия.",
  "properties": {
    "schema": { "const": "urn:ai-friends:schema:agent:v1:tool-result" },
    "request_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/uuid" },
    "trace_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/trace_id" },
    "status": { "enum": ["ok", "partial"] },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$", "maxLength": 64 },
    "tool_version": { "type": "integer", "minimum": 1 },
    "descriptor_hash": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/sha256" },
    "started_at": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/timestamp" },
    "finished_at": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/timestamp" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
    "effect": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/effect" },
    "output": { "$ref": "#/$defs/output" },
    "policy_decision_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/uuid" },
    "audit_event_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/uuid" },
    "approval_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/uuid" }
  },
  "required": [
    "schema",
    "request_id",
    "trace_id",
    "status",
    "tool",
    "tool_version",
    "descriptor_hash",
    "started_at",
    "finished_at",
    "attempt",
    "effect",
    "output",
    "policy_decision_id",
    "audit_event_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
      "then": {
        "properties": { "output": { "properties": { "truncated": { "const": true } } } },
        "description": "Частичный результат обязан быть помечен усечённым. Иначе агент делает вывод по обрезанному выводу, не зная, что он обрезан."
      }
    }
  ],
  "$defs": {
    "output": {
      "type": "object",
      "properties": {
        "provenance": {
          "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/provenance",
          "description": "Метка происхождения содержимого. Вывод команды на чужой машине — это remote_host, а не system: он полностью управляется тем, кто контролирует ту машину."
        },
        "truncated": { "type": "boolean" },
        "bytes": { "type": "integer", "minimum": 0 },
        "content_hash": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/sha256" },
        "content": {
          "type": "string",
          "maxLength": 1048576,
          "description": "Текстовое содержимое в кодировке UTF-8 с заменой недопустимых последовательностей. Двоичные данные сюда не кладутся: для них есть передача файлов, а попытка провести двоичный поток через текстовое поле ломает и канонизацию, и журнал."
        },
        "structured": {
          "type": "object",
          "description": "Разобранный результат для инструментов, которые возвращают данные, а не текст. Ключи определяет описание инструмента."
        },
        "exit_code": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "stream_ref": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" }
      },
      "required": ["provenance", "truncated", "bytes"],
      "additionalProperties": false
    }
  }
}
