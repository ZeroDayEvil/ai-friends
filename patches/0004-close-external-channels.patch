+import { securityHeaders } from '../lib/security-headers.js'
 
 export async function createApp () {
   const loadedCount = applySystemCAsToGlobalAgent()
@@ -25,6 +26,8 @@ export async function createApp () {
   // parse application/json
   app.use(express.json())
 
+  app.use(securityHeaders)
+
   // Проверка личности ставится до маршрутов, поэтому закрывает всё сразу,
   // включая рукопожатие WebSocket и статику. Режим включается наличием
   // настроек Cloudflare Access; если их нет, поведение как в стоковой версии.
diff --git a/src/app/server/sync.js b/src/app/server/sync.js
index 8469d83..f11d733 100644
--- a/src/app/server/sync.js
+++ b/src/app/server/sync.js
@@ -12,7 +12,29 @@ import { doWebdavSync } from './webdav-sync.js'
 
 rp.defaults.proxy = false
 
+// Куда разрешено синхронизировать закладки.
