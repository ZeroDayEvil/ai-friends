diff --git a/src/app/lib/cf-access.js b/src/app/lib/cf-access.js
new file mode 100644
index 0000000..863027f
--- /dev/null
+++ b/src/app/lib/cf-access.js
@@ -0,0 +1,134 @@
+/**
+ * Личность сотрудника из Cloudflare Access.
+ *
+ * Access ставит подписанный JWT в заголовок Cf-Access-Jwt-Assertion (и в куку
+ * CF_Authorization) для каждого проксируемого запроса. Мы проверяем подпись
+ * сами, а не доверяем факту «запрос пришёл из туннеля»: иначе любой, кто
+ * доберётся до порта приложения напрямую -- изнутри узла, из соседнего
+ * контейнера или через ошибку в конфиге туннеля -- войдёт без аутентификации.
+ *
+ * Своей парольной базы мы не заводим: SSO и второй фактор уже есть у Access,
+ * а у себя храним только роли и права.
+ */
+
+import jwt from 'jsonwebtoken'
+import { createPublicKey } from 'crypto'
+import log from '../common/log.js'
+
+const teamDomain = (process.env.CF_ACCESS_TEAM_DOMAIN || '').replace(/^https?:\/\//, '').replace(/\/$/, '')
+const audience = process.env.CF_ACCESS_AUD || ''
+
+export const cfAccessEnabled = Boolean(teamDomain && audience)
+
+// Переопределение адреса набора ключей нужно для тестов: в них поднимается
+// локальный сервер ключей. В рабочем окружении переменная не задаётся.
+const certsUrl = process.env.CF_ACCESS_CERTS_URL ||
+  `https://${teamDomain}/cdn-cgi/access/certs`
+
+const KEYS_TTL_MS = 60 * 60 * 1000
+const FETCH_TIMEOUT_MS = 5000
+
+let keyCache = { keys: null, fetchedAt: 0 }
+
+async function fetchKeys () {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS)
+  try {
+    const res = await fetch(certsUrl, { signal: controller.signal })
+    if (!res.ok) {
+      throw new Error(`certs endpoint returned ${res.status}`)
+    }
+    const body = await res.json()
+    if (!Array.isArray(body.keys) || !body.keys.length) {
+      throw new Error('certs endpoint returned no keys')
+    }
+    return body.keys
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+/**
+ * Ключи кешируются на час. Если нужного kid в кеше нет, кеш обновляется
+ * немедленно: Cloudflare периодически меняет ключи, и жёсткий TTL приводил бы
+ * к отказам входа на время до истечения кеша.
+ */
+async function getKey (kid) {
+  const fresh = Date.now() - keyCache.fetchedAt < KEYS_TTL_MS
+  if (!fresh || !keyCache.keys) {
+    keyCache = { keys: await fetchKeys(), fetchedAt: Date.now() }
+  }
+  let jwk = keyCache.keys.find(k => k.kid === kid)
+  if (!jwk && fresh) {
+    keyCache = { keys: await fetchKeys(), fetchedAt: Date.now() }
+    jwk = keyCache.keys.find(k => k.kid === kid)
+  }
+  if (!jwk) {
+    throw new Error(`no key for kid ${kid}`)
+  }
+  return createPublicKey({ key: jwk, format: 'jwk' })
+}
+
+/**
+ * Достаёт токен Access из запроса. Заголовок приоритетнее куки: куку браузер
+ * пришлёт и на запросы, которые Access не проверял.
+ */
+export function extractAccessToken (req) {
+  const header = req.headers['cf-access-jwt-assertion']
+  if (header) {
+    return header
+  }
+  const cookie = req.headers.cookie
+  if (!cookie) {
+    return ''
+  }
+  const match = /(?:^|;\s*)CF_Authorization=([^;]+)/.exec(cookie)
+  return match ? decodeURIComponent(match[1]) : ''
+}
+
+/**
+ * Проверяет токен и возвращает личность. Бросает исключение при любой
+ * неудаче: неверная подпись, чужая аудитория, истёкший срок.
+ */
+export async function verifyAccessToken (token) {
+  if (!token) {
+    throw new Error('no access token')
+  }
+  const decoded = jwt.decode(token, { complete: true })
+  if (!decoded?.header?.kid) {
+    throw new Error('malformed access token')
+  }
+  const key = await getKey(decoded.header.kid)
+  // Алгоритм задан явно: без этого подделанный заголовок alg может подсунуть
+  // другую схему проверки. Аудитория обязательна -- иначе токен, выданный для
+  // другого приложения того же аккаунта, подойдёт и к нашему.
+  const payload = jwt.verify(token, key, {
+    algorithms: ['RS256'],
+    audience,
+    issuer: `https://${teamDomain}`
+  })
+  const email = payload.email || payload.common_name
+  if (!email) {
+    throw new Error('access token has no identity')
+  }
+  return {
+    email: String(email).toLowerCase(),
+    sub: payload.sub,
+    expiresAt: payload.exp
+  }
+}
+
+/**
+ * Middleware. Ставится до маршрутов, поэтому закрывает и обычные запросы, и
+ * рукопожатие WebSocket: терминальный канал без этого остался бы открытым.
+ */
+export async function accessGuard (req, res, next) {
+  try {
+    const identity = await verifyAccessToken(extractAccessToken(req))
+    req.accessUser = identity.email
+    next()
+  } catch (err) {
+    log.error('access denied:', err.message)
+    res.status(401).send('access denied')
+  }
+}
