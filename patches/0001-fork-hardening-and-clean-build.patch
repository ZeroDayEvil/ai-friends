+# Скрипты пакетов не выполняются. Это основной путь атаки на цепочку поставок в
+# npm: preinstall/install/postinstall любого пакета в дереве зависимостей
+# запускается с правами того, кто ставит. Нужные исключения выполняются явно в
+# Dockerfile, а не разрешаются всем сразу.
+ignore-scripts=true
+
+# Точные версии при добавлении зависимостей: диапазон вида ^1.2.3 означает, что
+# в следующей сборке приедет другой код.
+save-exact=true
+
+# Upstream держит в devDependencies несовместимые по peer-диапазонам пакеты:
+# vite 8 требует @types/node 26, а закреплён 22. Конфликт касается только типов
+# времени сборки и на рантайм не влияет, но без этого флага npm отказывается
+# устанавливать дерево вообще. Флаг задан здесь, а не в командной строке, чтобы
+# локальная сборка и сборка в образе давали одинаковый результат.
+legacy-peer-deps=true
+
+fund=false
+audit=false
diff --git a/Dockerfile b/Dockerfile
new file mode 100644
index 0000000..a8f0a90
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,68 @@
+# Сборка форка electerm-web для платформы.
+#
+# Отличия от штатного образа проекта:
+#   - базовый образ закреплён digest-ом, а не тегом;
+#   - зависимости ставятся из package-lock.json с запретом скриптов пакетов;
+#   - нативные модули собираются из исходников, а не скачиваются готовыми;
+#   - процесс работает не под root.
+
+# node:24-bookworm-slim, digest получен 2026-08-15.
+# Обновление digest -- отдельное изменение с ревью, см. security/README.md.
+FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS builder
+
+WORKDIR /build
+
+# Инструменты компиляции нужны, чтобы собрать нативные модули у себя, а не
+# доверять чужим бинарникам.
+RUN apt-get update \
+ && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
+ && rm -rf /var/lib/apt/lists/*
+
+COPY package.json package-lock.json .npmrc ./
+
+# npm ci ставит строго то, что в lock-файле, и падает при расхождении с
+# package.json -- в отличие от npm install, который может тихо обновить дерево.
+RUN npm ci --ignore-scripts
+
+COPY . .
+
+# Белый список того, что нам действительно нужно выполнить. Каждая строка --
+# осознанное исключение из ignore-scripts.
+#
+# 1. Шаг сборки самого репозитория: раскладывает клиентскую часть из пакета
+#    @electerm/electerm-react. Это наш код, не сторонний postinstall.
+RUN node build/bin/install
+# 2. Нативные модули. --build-from-source обязателен: иначе node-gyp-build
+#    подхватит готовый бинарник, происхождение которого мы не проверяли.
+RUN npm rebuild --build-from-source node-pty @serialport/bindings-cpp
+# 3. Сборка клиентского бандла.
+RUN npm run build
+
+# Инструменты разработки в рабочий образ не попадают.
+RUN npm prune --omit=dev --ignore-scripts
+
+# ---------------------------------------------------------------------------
+FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03
+
+ENV NODE_ENV=production \
+    HOST=0.0.0.0 \
+    PORT=5577 \
+    ENABLE_AUTH=1 \
+    DISABLE_LOCAL_TERMINAL=1 \
+    TOKEN_EXPIRED_TIME=12h \
+    DB_PATH=/app/data
+
+WORKDIR /app
+
+# Пользователь node есть в базовом образе. Терминальный сервер под root -- это
+# готовая эскалация: любая ошибка в обработке ввода даёт права на контейнер.
+COPY --from=builder --chown=node:node /build /app
+# Каталоги состояния создаются заранее и передаются пользователю node: под
+# непривилегированным пользователем приложение не сможет создать их само.
+# Сюда монтируется том, поэтому это единственное место, где приложение пишет.
+RUN mkdir -p /app/data/uploads && chown -R node:node /app/data
+
+USER node
+EXPOSE 5577
+
+CMD ["node", "./src/app/app.js"]
