# Переводы строк фиксируем явно. Это не косметика: shell-скрипт с CRLF на Linux
# не запускается (интерпретатор ищет "/bin/bash\r"), а патч с CRLF не
# применяется.
* text=auto eol=lf

*.sh    text eol=lf
*.patch -text

# Скрипты Windows остаются с CRLF.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

*.png   binary
*.jpg   binary
