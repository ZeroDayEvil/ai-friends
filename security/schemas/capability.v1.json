{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-friends:schema:agent:v1:capability",
  "title": "Выданное полномочие",
  "type": "object",
  "description": "Полномочие — это пара «действие + множество объектов» с ограничениями и сроком. Ролей и уровней доступа как источника прав здесь нет: роль слишком крупная единица, чтобы по ней можно было ответить на вопрос «что именно этот агент может сделать прямо сейчас».",
  "properties": {
    "schema": { "const": "urn:ai-friends:schema:agent:v1:capability" },
    "capability_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/capability_id" },
    "action": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/action" },
    "selector": { "$ref": "#/$defs/selector" },
    "granted_to": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/principal_ref" },
    "granted_by": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/principal_ref" },
    "granted_at": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/timestamp" },
    "expires_at": {
      "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/timestamp",
      "description": "Обязателен. Бессрочное полномочие невозможно выразить: срок — единственный механизм отзыва, который работает без связи с центром."
    },
    "constraints": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/constraints" },
    "release": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/release" },
    "supervision": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/supervision" },
    "risk": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/risk" },
    "approval_policy": {
      "enum": ["never", "first_use", "always"],
      "description": "first_use означает «одно одобрение на набор аргументов в пределах окна», а не «одно одобрение навсегда»: привязка к хешу аргументов сохраняется."
    },
    "delegable": {
      "type": "boolean",
      "description": "Можно ли передать полномочие дальше по цепочке действующих лиц. По умолчанию false. Передача полномочия без явного разрешения — это способ, которым агент незаметно расширяет область действия."
    },
    "justification": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "description": "Зачем выдано. Поле обязательное: выдача без обоснования не проходит ревью и не поддаётся периодическому пересмотру прав."
    },
    "policy_version": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/policy_version" }
  },
  "required": [
    "schema",
    "capability_id",
    "action",
    "selector",
    "granted_to",
    "granted_by",
    "granted_at",
    "expires_at",
    "release",
    "supervision",
    "risk",
    "approval_policy",
    "delegable",
    "justification"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "risk": { "const": "critical" } }, "required": ["risk"] },
      "then": {
        "properties": {
          "approval_policy": { "const": "always" },
          "supervision": { "const": "supervised" },
          "delegable": { "const": false }
        },
        "description": "Критический риск не бывает предодобренным и не бывает автономным. Если действие нужно выполнять без человека, оно должно быть разбито на менее опасные шаги, а не переклассифицировано."
      }
    },
    {
      "if": { "properties": { "release": { "const": "A" } }, "required": ["release"] },
      "then": {
        "properties": { "supervision": { "const": "supervised" } },
        "description": "В релизе A автономного выполнения нет ни для одного полномочия."
      }
    }
  ],
  "$defs": {
    "selector": {
      "description": "Селектор описывает множество объектов. Варианта «все» не существует: множество всегда либо перечислено, либо задано идентификатором группы, состав которой перечислен в реестре. Отсутствие селектора — не «всё», а невалидная запись.",
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "none" }
          },
          "required": ["kind"],
          "additionalProperties": false,
          "description": "Явно пустая область. Нужна, чтобы «нет прав» было выразимым состоянием, а не отсутствием записи."
        },
        {
          "properties": {
            "kind": { "const": "machine" },
            "ids": { "type": "array", "items": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" }, "minItems": 1, "maxItems": 64, "uniqueItems": true },
            "protocols": { "type": "array", "items": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/protocol" }, "minItems": 1, "maxItems": 9, "uniqueItems": true }
          },
          "required": ["kind", "ids"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "machine_group" },
            "id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" },
            "protocols": { "type": "array", "items": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/protocol" }, "minItems": 1, "maxItems": 9, "uniqueItems": true }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "path" },
            "root_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" },
            "subpath": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/relpath" },
            "recursive": { "type": "boolean" },
            "max_depth": { "type": "integer", "minimum": 0, "maximum": 64 }
          },
          "required": ["kind", "root_id", "subpath", "recursive"],
          "additionalProperties": false,
          "description": "Сравнение идёт посегментно по канонизированному пути, а не сравнением строк-префиксов: префикс «docs» иначе совпал бы с «docs-secret»."
        },
        {
          "properties": {
            "kind": { "const": "session" },
            "owner": { "enum": ["self", "on_behalf_of"] }
          },
          "required": ["kind", "owner"],
          "additionalProperties": false,
          "description": "Агент видит либо свои сессии, либо сессии человека, от имени которого работает. Доступа к чужим сессиям по идентификатору не существует."
        },
        {
          "properties": {
            "kind": { "const": "bookmark_group" },
            "id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "credential_profile" },
            "ids": { "type": "array", "items": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" }, "minItems": 1, "maxItems": 64, "uniqueItems": true }
          },
          "required": ["kind", "ids"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "destination_group" },
            "id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "task" },
            "ids": { "type": "array", "items": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" }, "minItems": 1, "maxItems": 64, "uniqueItems": true }
          },
          "required": ["kind", "ids"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "command_template" },
            "ids": { "type": "array", "items": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" }, "minItems": 1, "maxItems": 128, "uniqueItems": true }
          },
          "required": ["kind", "ids"],
          "additionalProperties": false,
          "description": "Для command.exec множество задаётся списком шаблонов команд с типизированными параметрами. Запретительного списка регулярных выражений в контракте нет: регулярное выражение не является разбором командной строки и обходится кодировкой, подстановкой переменных и склейкой."
        },
        {
          "properties": {
            "kind": { "const": "browser_profile" },
            "ids": { "type": "array", "items": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/slug" }, "minItems": 1, "maxItems": 16, "uniqueItems": true }
          },
          "required": ["kind", "ids"],
          "additionalProperties": false
        }
      ]
    }
  }
}
