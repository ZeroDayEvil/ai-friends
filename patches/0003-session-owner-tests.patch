---
 test/session-owner.test.mjs | 76 +++++++++++++++++++++++++++++++++++++
 1 file changed, 76 insertions(+)
 create mode 100644 test/session-owner.test.mjs

diff --git a/test/session-owner.test.mjs b/test/session-owner.test.mjs
new file mode 100644
index 0000000..d343b09
--- /dev/null
+++ b/test/session-owner.test.mjs
@@ -0,0 +1,76 @@
+/**
+ * Проверка реестра владельцев сессий.
+ *
+ * Запуск: node test/session-owner.test.mjs
+ */
+
+import assert from 'assert'
+import {
+  claimSession,
+  releaseSession,
+  assertSessionOwner,
+  ownerOf
+} from '../src/app/lib/session-owner.js'
+
+const results = []
+function check (name, fn) {
+  try {
+    fn()
+    results.push(['PASS', name])
+  } catch (err) {
+    results.push(['FAIL', name, err.message])
+  }
+}
+
+check('владелец запоминается при создании сессии', () => {
+  claimSession('pid-1', 'ivanov@example.com')
+  assert.strictEqual(ownerOf('pid-1'), 'ivanov@example.com')
+})
+
+check('владелец подключается к своей сессии', () => {
+  assertSessionOwner('pid-1', 'ivanov@example.com')
+})
+
+check('чужой пользователь к сессии не подключается', () => {
+  assert.throws(
+    () => assertSessionOwner('pid-1', 'petrov@example.com'),
+    /another user/
+  )
+})
+
+check('сессия с неизвестным владельцем недоступна', () => {
+  assert.throws(
+    () => assertSessionOwner('pid-unknown', 'ivanov@example.com'),
+    /unknown session/
+  )
+})
+
+check('после закрытия сессии доступ к идентификатору закрыт', () => {
+  claimSession('pid-2', 'ivanov@example.com')
+  releaseSession('pid-2')
+  assert.throws(
+    () => assertSessionOwner('pid-2', 'ivanov@example.com'),
+    /unknown session/
+  )
+})
+
+check('пустые значения не создают владельца', () => {
+  claimSession('', 'ivanov@example.com')
+  claimSession('pid-3', undefined)
+  assert.throws(() => assertSessionOwner('pid-3', 'ivanov@example.com'), /unknown session/)
+})
+
+// Однопользовательский режим: владельцем становится идентификатор из токена,
+// то есть SERVER_USER. Проверка при этом продолжает работать, поэтому старое
+// поведение не ломается.
+check('режим общего пользователя продолжает работать', () => {
+  claimSession('pid-4', 'default_user')
+  assertSessionOwner('pid-4', 'default_user')
+})
+
+const failed = results.filter(r => r[0] === 'FAIL')
+for (const r of results) {
+  console.log(`${r[0]}  ${r[1]}${r[2] ? '  -- ' + r[2] : ''}`)
+}
+console.log(`\nвсего ${results.length}, провалено ${failed.length}`)
+process.exit(failed.length ? 1 : 0)
