{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-friends:schema:agent:v1:tool-error",
  "title": "Отказ или сбой инструмента",
  "type": "object",
  "description": "Отдельная форма, а не результат с флагом ошибки. Причина в том, что отказ обязан нести две вещи, которых нет у успеха: причину из закрытого списка и утверждение о состоянии цели. По этим двум полям строится и автоматика повторов, и разбор инцидента.",
  "properties": {
    "schema": { "const": "urn:ai-friends:schema:agent:v1:tool-error" },
    "request_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/uuid" },
    "trace_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/trace_id" },
    "status": { "const": "error" },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$", "maxLength": 64 },
    "tool_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/timestamp" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
    "reason": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/reason" },
    "effect": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/effect" },
    "retryable": { "type": "boolean" },
    "retry_after_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
    "retry_requires_idempotency_key": { "type": "boolean" },
    "policy_decision_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/uuid" },
    "approval_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/uuid" },
    "audit_event_id": { "$ref": "urn:ai-friends:schema:agent:v1:common#/$defs/uuid" },
    "operator_action_required": {
      "type": "boolean",
      "description": "Требуется ли вмешательство человека до следующей попытки. Всегда истинно при effect=unknown: состояние цели неизвестно, и решать, повторять ли, автоматике нельзя."
    }
  },
  "required": [
    "schema",
    "request_id",
    "trace_id",
    "status",
    "tool",
    "tool_version",
    "occurred_at",
    "attempt",
    "reason",
    "effect",
    "retryable",
    "audit_event_id",
    "operator_action_required"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "properties": {
              "code": {
                "enum": [
                  "unauthenticated",
                  "unauthorized",
                  "capability_missing",
                  "capability_expired",
                  "scope_empty",
                  "approval_required",
                  "approval_expired",
                  "approval_mismatch",
                  "approval_replayed",
                  "policy_denied",
                  "policy_unavailable",
                  "supervisor_absent",
                  "release_not_enabled",
                  "untrusted_provenance",
                  "invalid_args",
                  "unsupported_tool",
                  "tool_descriptor_mismatch",
                  "target_unknown",
                  "protected_path",
                  "containment_violation",
                  "egress_blocked",
                  "secret_unavailable",
                  "host_key_changed",
                  "rate_limited",
                  "quota_exceeded"
                ]
              }
            },
            "required": ["code"]
          }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": { "effect": { "const": "none" } },
        "description": "Все перечисленные причины возникают до того, как что-либо было сделано с целью. Если реализация не может этого гарантировать, она обязана вернуть другой код, а не подписаться под effect=none."
      }
    },
    {
      "if": {
        "properties": { "effect": { "const": "unknown" } },
        "required": ["effect"]
      },
      "then": {
        "properties": { "operator_action_required": { "const": true } }
      }
    },
    {
      "if": {
        "properties": {
          "retryable": { "const": true },
          "effect": { "not": { "const": "none" } }
        },
        "required": ["retryable", "effect"]
      },
      "then": {
        "required": ["retry_requires_idempotency_key"],
        "properties": { "retry_requires_idempotency_key": { "const": true } },
        "description": "Повтор после того, как что-то могло произойти, допустим только для идемпотентных инструментов и только с тем же ключом. Для at_most_once таких отказов не бывает: они обязаны приходить с retryable=false."
      }
    },
    {
      "if": {
        "properties": { "reason": { "properties": { "code": { "const": "policy_unavailable" } }, "required": ["code"] } },
        "required": ["reason"]
      },
      "then": {
        "properties": { "effect": { "const": "none" }, "retryable": { "const": true } },
        "description": "Недоступность службы политики — это отказ, а не разрешение. Исполнитель, не получивший решения, не выполняет ничего."
      }
    }
  ]
}
