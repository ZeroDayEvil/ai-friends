diff --git a/src/app/lib/security-headers.js b/src/app/lib/security-headers.js
new file mode 100644
index 0000000..cf39a7f
--- /dev/null
+++ b/src/app/lib/security-headers.js
@@ -0,0 +1,34 @@
+/**
+ * Заголовки безопасности.
+ *
+ * Главный здесь -- connect-src в Content-Security-Policy. Клиентская часть
+ * приходит готовым npm-пакетом @electerm/electerm-react, и в нём зашит канал
+ * проверки обновлений с адресами electerm-mirror.html5beta.com,
+ * electerm-store.html5beta.com и sourceforge, а также список внешних
+ * ИИ-провайдеров. Править минифицированный бандл ненадёжно и ломается при
+ * каждом обновлении, поэтому запрет ставится там, где его нельзя обойти из
+ * кода страницы: браузер сам не даст обратиться к чужому адресу.
+ *
+ * Ограничен именно connect-src, а не весь CSP: директивы для скриптов и стилей
+ * потребовали бы разбора бандла и могли бы сломать интерфейс, а на утечку
+ * данных влияет именно исходящий запрос.
+ */
+
+// Дополнительные адреса (например, свой ИИ-эндпоинт или свой WebDAV) задаются
+// администратором и добавляются к списку.
+const extra = (process.env.CSP_CONNECT_EXTRA || '')
+  .split(',')
+  .map(s => s.trim())
+  .filter(Boolean)
+
+const connectSrc = ["'self'", 'ws:', 'wss:', ...extra].join(' ')
+
+export function securityHeaders (req, res, next) {
+  res.setHeader('Content-Security-Policy', `connect-src ${connectSrc}`)
+  // Браузер не должен угадывать тип содержимого: подмена типа -- путь к
+  // исполнению загруженного файла как скрипта.
+  res.setHeader('X-Content-Type-Options', 'nosniff')
+  // Адреса внутренних машин не должны утекать в Referer при переходах наружу.
+  res.setHeader('Referrer-Policy', 'no-referrer')
+  next()
+}
